{
  "realm": "veterinaria",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 900,
  "roles": {
    "realm": [
      {
        "name": "ADMIN",
        "description": "Administrador: puede hacer todo",
        "composite": true,
        "composites": {
          "client": {
            "persistencia-api": ["perro:leer", "duenno:leer", "duenno:escribir", "duenno:eliminar", "chat:usar"]
          }
        }
      },
      {
        "name": "VETERINARIO",
        "description": "Personal de la veterinaria: lee y edita duennos, no elimina",
        "composite": true,
        "composites": {
          "client": {
            "persistencia-api": ["perro:leer", "duenno:leer", "duenno:escribir", "chat:usar"]
          }
        }
      },
      {
        "name": "CLIENTE",
        "description": "Cliente de la veterinaria: solo consulta perros",
        "composite": true,
        "composites": {
          "client": {
            "persistencia-api": ["perro:leer"]
          }
        }
      }
    ],
    "client": {
      "persistencia-api": [
        { "name": "perro:leer", "description": "Consultar perros" },
        { "name": "duenno:leer", "description": "Consultar duennos" },
        { "name": "duenno:escribir", "description": "Crear y actualizar duennos" },
        { "name": "duenno:eliminar", "description": "Eliminar duennos" },
        { "name": "chat:usar", "description": "Usar el asistente de IA" }
      ]
    }
  },
  "clients": [
    {
      "clientId": "persistencia-api",
      "name": "API de Persistencia (Spring Boot)",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": ["http://localhost:*", "https://oauth.pstmn.io/v1/callback"],
      "webOrigins": ["+"],
      "fullScopeAllowed": true
    }
  ],
  "users": [
    {
      "username": "ana",
      "enabled": true,
      "email": "ana@veterinaria.local",
      "emailVerified": true,
      "firstName": "Ana",
      "lastName": "Admin",
      "credentials": [{ "type": "password", "value": "ana123", "temporary": false }],
      "realmRoles": ["ADMIN"]
    },
    {
      "username": "victor",
      "enabled": true,
      "email": "victor@veterinaria.local",
      "emailVerified": true,
      "firstName": "Victor",
      "lastName": "Veterinario",
      "credentials": [{ "type": "password", "value": "victor123", "temporary": false }],
      "realmRoles": ["VETERINARIO"]
    },
    {
      "username": "carla",
      "enabled": true,
      "email": "carla@veterinaria.local",
      "emailVerified": true,
      "firstName": "Carla",
      "lastName": "Cliente",
      "credentials": [{ "type": "password", "value": "carla123", "temporary": false }],
      "realmRoles": ["CLIENTE"]
    }
  ]
}
