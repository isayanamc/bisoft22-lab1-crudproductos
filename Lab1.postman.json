{
  "info": {
    "name": "Lab 1 CRUD Productos",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "categoriaId",
      "value": ""
    },
    {
      "key": "productoId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Login admin",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/auth/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"admin\", \"password\": \"admin123\"}"
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.collectionVariables.set(\"token\", pm.response.json().access_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Registrar categoría",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/categorias",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"nombre\": \"Bebidas\", \"descripcion\": \"Frias y calientes\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.collectionVariables.set(\"categoriaId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Listar categorías",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/categorias"
      }
    },
    {
      "name": "Actualizar categoría",
      "request": {
        "method": "PUT",
        "url": "{{baseUrl}}/api/v1/categorias/{{categoriaId}}",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"nombre\": \"Bebidas\", \"descripcion\": \"Cafe y te\"}"
        }
      }
    },
    {
      "name": "Registrar producto",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/productos",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"nombre\": \"Cafe\", \"descripcion\": \"500 g\", \"precio\": 3500, \"stock\": 20, \"categoriaId\": {{categoriaId}}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.collectionVariables.set(\"productoId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Listar productos",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/productos"
      }
    },
    {
      "name": "Actualizar producto",
      "request": {
        "method": "PUT",
        "url": "{{baseUrl}}/api/v1/productos/{{productoId}}",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"nombre\": \"Cafe\", \"descripcion\": \"500 g\", \"precio\": 3200, \"stock\": 18, \"categoriaId\": {{categoriaId}}}"
        }
      }
    },
    {
      "name": "Borrar categoria con productos (409)",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/v1/categorias/{{categoriaId}}"
      }
    },
    {
      "name": "Borrar producto",
    "request": {
      "method": "DELETE",
      "url": "{{baseUrl}}/api/v1/productos/{{productoId}}"
    }
    },
    {
      "name": "Borrar categoria",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/v1/categorias/{{categoriaId}}"
      }
    }

  ]
}